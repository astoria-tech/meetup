---
import MainLayout from "../../../layouts/MainLayout.astro";
import {
  getEventsByType,
  getEventTypeLabel,
  getEventTypeDescription,
  type EventType,
  type CategorizedEvent,
} from "../../../utils/meetupApi";
import EventCard from "../../../components/EventCard.astro";
import {
  EVENTS_PER_PAGE,
  eventJsonLd,
  eventTypePageCounts,
} from "../../../utils/seo";

export async function getStaticPaths() {
  const paths = [];

  // Past-event page counts per type (shared with the sitemap)
  const pageCounts = await eventTypePageCounts();
  for (const [type, totalPages] of Object.entries(pageCounts)) {
    // Generate a path for each page
    for (let pageNum = 1; pageNum <= totalPages; pageNum++) {
      paths.push({
        params: {
          type,
          page: pageNum === 1 ? undefined : String(pageNum),
        },
      });
    }
  }

  return paths;
}

const { type, page } = Astro.params as { type: EventType; page?: string };
const events = await getEventsByType(type);
const label = getEventTypeLabel(type);
const description = getEventTypeDescription(type);

// Get emoji for event type
function getEventEmoji(eventType: EventType): string {
  switch (eventType) {
    case "mornings":
      return "☀️";
    case "evenings":
      return "🌙";
    case "hackathons":
      return "🚀";
    default:
      return "💡";
  }
}
const emoji = getEventEmoji(type);

// Separate upcoming and past events
const now = new Date();
const upcomingEvents = events
  .filter((event) => new Date(event.dateTime) >= now)
  .sort(
    (a, b) => new Date(a.dateTime).getTime() - new Date(b.dateTime).getTime(),
  );
const pastEvents = events.filter((event) => new Date(event.dateTime) < now);

// Pagination for past events
const currentPage = page ? parseInt(page) : 1;
const totalPastPages = Math.ceil(pastEvents.length / EVENTS_PER_PAGE);
const paginatedPastEvents = pastEvents.slice(
  (currentPage - 1) * EVENTS_PER_PAGE,
  currentPage * EVENTS_PER_PAGE,
);

// Get date range for current page
function getDateRange(events: CategorizedEvent[]) {
  if (events.length === 0) return null;
  const dates = events.map((e) => new Date(e.dateTime));
  const earliest = new Date(Math.min(...dates.map((d) => d.getTime())));
  const latest = new Date(Math.max(...dates.map((d) => d.getTime())));
  return { earliest, latest };
}

// Generate pagination URL
function getPageUrl(pageNum: number): string {
  return pageNum === 1 ? `/events/${type}` : `/events/${type}/${pageNum}`;
}

const pastDateRange = getDateRange(paginatedPastEvents);

// Per-page SEO: each type (and each page of its archive) gets its own title
// and description. Upcoming events are marked up as schema.org Events on
// page 1 only, so the same event isn't listed from several URLs.
const plainLabel = label.replace(/^[^\s]+\s/, "");
const seoDescriptions: Record<EventType, string> = {
  mornings:
    "Morning Coffee: weekly morning chats over breakfast in Astoria about careers, tech, local events and side projects. Upcoming dates and past meetups.",
  evenings:
    "Monthly evening meetups in Astoria, Queens: technical talks, live demos and open discussion. Upcoming dates, venues and every past meetup.",
  hackathons:
    "Astoria Tech hackathons: focused 5-hour building sessions at local Astoria venues. Bring an idea or join a team on the spot.",
};
const pageTitle =
  currentPage > 1
    ? `${plainLabel}: Past Events, Page ${currentPage}`
    : plainLabel;
const pageDescription =
  currentPage > 1
    ? `Past ${plainLabel} events from Astoria Tech Meetup, page ${currentPage} of ${totalPastPages}.`
    : seoDescriptions[type];
const pageJsonLd =
  currentPage === 1
    ? upcomingEvents
        .map((event) => eventJsonLd(event, Astro.site))
        .filter((node) => node !== null)
    : [];
---

<MainLayout title={pageTitle} description={pageDescription} jsonLd={pageJsonLd}>
  <!-- Page Header -->
  <section class="mb-12">
    <div class="max-w-3xl mx-auto">
      <h1
        class="text-4xl font-bold text-emerald-900 mb-4 flex items-center gap-3"
      >
        <span>{label.replace(/^[^\s]+\s/, "")}</span>
        <span>{emoji}</span>
      </h1>
      <div class="text-lg text-emerald-700 space-y-1">
        {
          description
            .split("\n")
            .map((line) => <p class="leading-relaxed">{line}</p>)
        }
      </div>
    </div>
  </section>

  <!-- Upcoming Events -->
  {
    upcomingEvents.length > 0 && (
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-emerald-900 mb-6">Upcoming</h2>
        <div class="space-y-4">
          {upcomingEvents.map((event) => (
            <EventCard event={event} />
          ))}
        </div>
      </section>
    )
  }

  <!-- Past Events -->
  <section>
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-2xl font-bold text-emerald-900">Past</h2>
        {
          pastDateRange && (
            <p class="text-sm text-emerald-600 mt-1">
              {pastDateRange.latest.toLocaleDateString("en-US", {
                month: "short",
                day: "numeric",
                year: "numeric",
              })}{" "}
              -{" "}
              {pastDateRange.earliest.toLocaleDateString("en-US", {
                month: "short",
                day: "numeric",
                year: "numeric",
              })}
            </p>
          )
        }
      </div>
      {
        pastEvents.length > 0 && (
          <div class="text-sm text-emerald-600">
            Page {currentPage} of {totalPastPages} • {pastEvents.length} total
            events
          </div>
        )
      }
    </div>
    {
      paginatedPastEvents.length > 0 ? (
        <div class="space-y-4">
          {paginatedPastEvents.map((event) => (
            <EventCard event={event} isPast={true} />
          ))}
        </div>
      ) : (
        <div class="bg-white rounded-lg border border-green-200 p-8 text-center">
          <p class="text-emerald-700 text-lg mb-2">
            {type === "hackathons"
              ? "Check back soon for upcoming hackathons!"
              : `No past ${label.replace(/^[^\s]+\s/, "").toLowerCase()} events yet.`}
          </p>
          <p class="text-emerald-600 text-sm">
            Join us on{" "}
            <a
              href="https://discord.gg/RNbuNQGP"
              class="text-emerald-600 hover:text-emerald-800 underline font-semibold"
              target="_blank"
              rel="noopener noreferrer"
            >
              Discord
            </a>{" "}
            for the latest updates.
          </p>
        </div>
      )
    }

    {/* Pagination Controls */}
    {
      totalPastPages > 1 && (
        <div class="mt-8 flex items-center justify-center gap-2">
          {currentPage > 1 && (
            <a
              href={getPageUrl(currentPage - 1)}
              class="px-4 py-2 text-sm font-medium text-emerald-700 bg-white border border-emerald-300 rounded-lg hover:bg-emerald-50 transition-colors"
            >
              ← Previous
            </a>
          )}

          <div class="flex gap-1">
            {/* First page */}
            <a
              href={getPageUrl(1)}
              class={`px-3 py-2 text-sm font-medium rounded-lg transition-colors ${
                currentPage === 1
                  ? "bg-emerald-600 text-white"
                  : "text-emerald-700 bg-white border border-emerald-300 hover:bg-emerald-50"
              }`}
            >
              1
            </a>

            {/* Ellipsis after first page */}
            {currentPage > 3 && (
              <span class="px-2 text-emerald-600 flex items-center">...</span>
            )}

            {/* Previous page */}
            {currentPage > 2 && (
              <a
                href={getPageUrl(currentPage - 1)}
                class="px-3 py-2 text-sm font-medium rounded-lg transition-colors text-emerald-700 bg-white border border-emerald-300 hover:bg-emerald-50"
              >
                {currentPage - 1}
              </a>
            )}

            {/* Current page (if not first or last) */}
            {currentPage > 1 && currentPage < totalPastPages && (
              <span class="px-3 py-2 text-sm font-medium rounded-lg bg-emerald-600 text-white">
                {currentPage}
              </span>
            )}

            {/* Next page */}
            {currentPage < totalPastPages - 1 && (
              <a
                href={getPageUrl(currentPage + 1)}
                class="px-3 py-2 text-sm font-medium rounded-lg transition-colors text-emerald-700 bg-white border border-emerald-300 hover:bg-emerald-50"
              >
                {currentPage + 1}
              </a>
            )}

            {/* Ellipsis before last page */}
            {currentPage < totalPastPages - 2 && (
              <span class="px-2 text-emerald-600 flex items-center">...</span>
            )}

            {/* Last page */}
            {totalPastPages > 1 && (
              <a
                href={getPageUrl(totalPastPages)}
                class={`px-3 py-2 text-sm font-medium rounded-lg transition-colors ${
                  currentPage === totalPastPages
                    ? "bg-emerald-600 text-white"
                    : "text-emerald-700 bg-white border border-emerald-300 hover:bg-emerald-50"
                }`}
              >
                {totalPastPages}
              </a>
            )}
          </div>

          {currentPage < totalPastPages && (
            <a
              href={getPageUrl(currentPage + 1)}
              class="px-4 py-2 text-sm font-medium text-emerald-700 bg-white border border-emerald-300 rounded-lg hover:bg-emerald-50 transition-colors"
            >
              Next →
            </a>
          )}
        </div>
      )
    }
  </section>
</MainLayout>
