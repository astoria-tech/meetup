---
import "../style.css";
import copy from "../copy";
import { getCssUrl, getLink } from "../components/Link.astro";

type Props = {
  title?: string;
  bodyClass?: string[];
  useWavyBackground?: boolean;
};

const { title, useWavyBackground, bodyClass = [] } = Astro.props;
const applyWavyBackground = useWavyBackground ? ["wavy-background"] : [];
---

<style define:vars={{ background: getCssUrl("/css/wavy-background.svg") }}>
  .wavy-background {
    background-color: #2d272e;
    background-image: var(--background);
    background-attachment: fixed;
  }
</style>

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // On page load or when changing themes, best to add inline in `head` to avoid FOUC
      if (
        localStorage.getItem("theme") === "dark" ||
        (!("theme" in localStorage) &&
          window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script>
    <link
      rel="alternate"
      type="application/rss+xml"
      title="RSS Feed for astoria.app"
      href={getLink("rss.xml")}
    />
    <link
      rel="icon"
      type="image/png"
      href="../design/symbol-black-logo.png"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/png"
      href="../design/symbol-white-logo.png"
      media="(prefers-color-scheme: dark)"
    />
    {
      /* PWA install: manifest + apple-touch-icon pin the installed / home-screen
        icon to the black logo (on white), independent of the theme-aware tab
        favicons above — otherwise a dark-mode install grabs the white symbol. */
    }
    <link rel="manifest" href={getLink("manifest.webmanifest")} />
    <link rel="apple-touch-icon" href={getLink("apple-touch-icon.png")} />
    <meta name="apple-mobile-web-app-title" content="Astoria Tech Meetup" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={copy.siteDescription} />
    <title>
      {title ? `${title} | ${copy.defaultPageTitle}` : copy.defaultPageTitle}
    </title>
  </head>

  <body class:list={[bodyClass, ...applyWavyBackground]}>
    <slot />
  </body>
</html>
