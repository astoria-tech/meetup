---
import "../style.css";
import copy from "../copy";
import { getCssUrl, getLink } from "../components/Link.astro";
import { iconVersion } from "../utils/assetVersion";
import {
  SITE_NAME,
  OG_IMAGE,
  absoluteUrl,
  organizationJsonLd,
} from "../utils/seo";

type Props = {
  /** Short page title; " | Astoria Tech Meetup" is appended. Omit on home. */
  title?: string;
  /** Meta/OG description, 160 chars max. Defaults to the site description. */
  description?: string;
  /** Keep this page out of search (redirect stubs, dev pages). */
  noindex?: boolean;
  /** Extra schema.org nodes for this page, merged into one JSON-LD @graph. */
  jsonLd?: object[];
  bodyClass?: string[];
  useWavyBackground?: boolean;
};

const {
  title,
  description = copy.siteDescription,
  noindex = false,
  jsonLd = [],
  useWavyBackground,
  bodyClass = [],
} = Astro.props;
const fullTitle = title ? `${title} | ${SITE_NAME}` : copy.homeTitle;
const canonical = absoluteUrl(Astro.site, Astro.url.pathname);
const ogImage = absoluteUrl(Astro.site, OG_IMAGE.path);
const graph = noindex ? [] : [organizationJsonLd(Astro.site), ...jsonLd];
const applyWavyBackground = useWavyBackground ? ["wavy-background"] : [];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <style define:vars={{ background: getCssUrl("/css/wavy-background.svg") }}>
      .wavy-background {
        background-color: #2d272e;
        background-image: var(--background);
        background-attachment: fixed;
      }
    </style>
    <script is:inline>
      // On page load or when changing themes, best to add inline in `head` to avoid FOUC
      if (
        localStorage.getItem("theme") === "dark" ||
        (!("theme" in localStorage) &&
          window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    </script>
    <link
      rel="icon"
      type="image/png"
      href={getLink("design/symbol-black-logo.png")}
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/png"
      href={getLink("design/symbol-white-logo.png")}
      media="(prefers-color-scheme: dark)"
    />
    {
      /* PWA install: manifest + apple-touch-icon pin the installed / home-screen
        icon to the black logo (on white), independent of the theme-aware tab
        favicons above — otherwise a dark-mode install grabs the white symbol.
        The ?v=<hash> (build-time icon content hash) busts the Cloudflare / browser
        / OS icon caches whenever the icon changes — see utils/assetVersion. */
    }
    <link
      rel="manifest"
      href={getLink(`manifest.webmanifest?v=${iconVersion}`)}
    />
    <link
      rel="apple-touch-icon"
      href={getLink(`apple-touch-icon.png?v=${iconVersion}`)}
    />
    <meta name="apple-mobile-web-app-title" content="Astoria Tech Meetup" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <link rel="canonical" href={canonical} />
      )
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title ?? SITE_NAME} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta property="og:image:alt" content={OG_IMAGE.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE_NAME} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={OG_IMAGE.alt} />
    {
      graph.length > 0 && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@graph": graph,
          }).replace(/</g, "\\u003c")}
        />
      )
    }
  </head>

  <body class:list={[bodyClass, ...applyWavyBackground]}>
    <slot />
  </body>
</html>
